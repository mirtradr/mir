{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/trading/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|initials|size|tone|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, initials, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|brand|dark|up|down)$/]",
        "message": "<Avatar> tone must be one of 'sand' | 'brand' | 'dark' | 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|size|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, size, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|up|down|info|warn)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'up' | 'down' | 'info' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shape|iconLeft|iconRight|disabled|full|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, shape, iconLeft, iconRight, disabled, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|rounded)$/]",
        "message": "<Button> shape must be one of 'pill' | 'rounded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuySellToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|buyLabel|sellLabel|size|key|ref|className|style|children)$/]",
        "message": "<BuySellToggle> doesn't accept that prop. Declared props: value, onChange, buyLabel, sellLabel, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuySellToggle'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:buy|sell)$/]",
        "message": "<BuySellToggle> value must be one of 'buy' | 'sell'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuySellToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<BuySellToggle> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|pad|radius|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, pad, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|sunk|glass|dark|sun)$/]",
        "message": "<Card> variant must be one of 'soft' | 'sunk' | 'glass' | 'dark' | 'sun'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> pad must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:md|lg|xl|card|2xl)$/]",
        "message": "<Card> radius must be one of 'md' | 'lg' | 'xl' | 'card' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|format|size|variant|showArrow|key|ref|className|style|children)$/]",
        "message": "<ChangePill> doesn't accept that prop. Declared props: value, format, size, variant, showArrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangePill'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:percent|absolute)$/]",
        "message": "<ChangePill> format must be one of 'percent' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangePill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ChangePill> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangePill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|bare)$/]",
        "message": "<ChangePill> variant must be one of 'soft' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|label|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|brand|glass|plain)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'brand' | 'glass' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|trailing|size|surface|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: icon, trailing, size, surface, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Input> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:sunk|card|glass)$/]",
        "message": "<Input> surface must be one of 'sunk' | 'card' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PositionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|name|price|change|series|logo|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<PositionRow> doesn't accept that prop. Declared props: symbol, name, price, change, series, logo, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PositionRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|brand|dark|up|down)$/]",
        "message": "<PositionRow> tone must be one of 'sand' | 'brand' | 'dark' | 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|width|height|color|fill|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, width, height, color, fill, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaFormat|size|align|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: label, value, delta, deltaFormat, size, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='deltaFormat'] > Literal[value!=/^(?:percent|absolute)$/]",
        "message": "<Stat> deltaFormat must be one of 'percent' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Stat> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Stat> align must be one of 'left' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
